{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "build:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "deploy:testnet": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["deployments/testnet.json"]
    },
    "format": {
      "cache": false,
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:generate": {
      "cache": false,
      "outputs": []
    },
    "db:migrate": {
      "cache": false,
      "outputs": []
    },
    "contract:test": {
      "cache": false,
      "outputs": ["target/**"]
    },
    "contract:build": {
      "cache": false,
      "outputs": ["target/**"]
    },
    "sdk:build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "NODE_ENV",
    "STELLAR_RPC_URL",
    "HORIZON_URL",
    "STELLAR_NETWORK",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL",
    "NEXT_PUBLIC_STELLAR_NETWORK",
    "NEXT_PUBLIC_SWYFT_API_KEY"
  ]
}
