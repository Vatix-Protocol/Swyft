# ── Stellar Network ───────────────────────────────────────────────────────────
# "TESTNET" or "PUBLIC". Drives the default network passphrase, RPC fallback,
# and stellar.expert explorer links (see apps/web/lib/constants.ts). The
# network passphrase itself is derived automatically from this value — there
# is no separate NEXT_PUBLIC_*_PASSPHRASE var to set.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Soroban RPC endpoint used for on-chain reads/writes via @swyft/sdk in the
# browser (apps/web/hooks/useMevProtection.ts). Falls back to the public
# testnet RPC below when unset or malformed.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional: MEV-protected Soroban RPC endpoint, used instead of
# NEXT_PUBLIC_SOROBAN_RPC_URL when the user opts in to MEV protection in the
# UI. Leave blank to fall back to NEXT_PUBLIC_SOROBAN_RPC_URL.
NEXT_PUBLIC_MEV_PROTECTED_RPC_URL=

# ── Swyft API ──────────────────────────────────────────────────────────────────
# Base URL of the apps/api NestJS service (no trailing slash, no /v1 suffix —
# that's appended automatically). See apps/api/.env.example for the API's own
# config, and docker-compose.yml for the in-container default.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Per-network API base URL overrides (apps/web/lib/constants.ts). When set,
# these take precedence over NEXT_PUBLIC_API_URL for the matching network —
# the UI lets users switch between TESTNET and PUBLIC at runtime, and each
# network must talk to its own API deployment. Leave blank to fall back to
# NEXT_PUBLIC_API_URL.
#
# PRODUCTION REQUIREMENT: a PUBLIC/mainnet deployment MUST set
# NEXT_PUBLIC_API_URL_PUBLIC to the production API URL. If it is unset (or
# blank), mainnet traffic silently falls back to NEXT_PUBLIC_API_URL — usually
# the testnet API or localhost — so quotes, indexer data, LP positions, and
# wallet flows will show the wrong network's data with no warning.
NEXT_PUBLIC_API_URL_TESTNET=
NEXT_PUBLIC_API_URL_PUBLIC=

# Optional: WebSocket URL for live price-candle/swap-quote updates
# (apps/web/hooks/usePriceCandles.ts, useSwapQuote.ts). Leave blank to derive
# it from NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WS_URL=

# API key sent as X-Api-Key on the read-only market-data endpoints (pools,
# prices, tokens, swaps, search) now that they're behind the API's
# ApiKeyGuard — see apps/web/lib/api-fetch.ts. Provision one via
# `POST /auth/api-keys` (requires a signed-in wallet) and set it here.
NEXT_PUBLIC_SWYFT_API_KEY=

# ── Contract Addresses ────────────────────────────────────────────────────────
# Deployed Soroban contract IDs for the active network, sourced from the
# deployments registry at packages/contract/deployments/testnet.json (or the
# mainnet equivalent). Optional for local dev against the API's own
# POOL_CONTRACT_ID (see apps/api/.env.example) — set here only if the
# frontend needs to address contracts directly.
NEXT_PUBLIC_POOL_CONTRACT_ID=
