# ── Database (Prisma) ─────────────────────────────────────────────────────────
# Validated at startup (postgres:// or postgresql://); required in every
# environment, and the app refuses to start if it is missing or malformed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swyft

# ── Redis (BullMQ + Cache) ────────────────────────────────────────────────────
# Validated at startup (redis:// or rediss://). Outside production an unset
# value defaults to the local instance below; in production it is required
# explicitly, with no silent fallback.
REDIS_URL=redis://localhost:6379

# ── Stellar RPC & Horizon ─────────────────────────────────────────────────────
# Both URLs are validated at startup and, if malformed, the app refuses to
# start regardless of environment. In production (NODE_ENV=production) they
# are also REQUIRED — the app refuses to start if either is missing, with no
# silent fallback to testnet. Outside production, an unset value defaults to
# the public testnet endpoint shown below, for local-dev convenience.
#
# For production deployments, supply these via CI/CD secrets (e.g. GitHub
# Actions secrets: STELLAR_RPC_URL, HORIZON_URL) — never commit real values.
#
# STELLAR_NETWORK must be one of: testnet | mainnet
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
HORIZON_TIMEOUT_MS=10000

# ── Contract Addresses ────────────────────────────────────────────────────────
# Source of truth for testnet IDs:
#   packages/contract/deployments/testnet.json
#   packages/contract/deployments/TESTNET.md
#
# After `pnpm --filter contracts deploy:testnet`, copy values from
# `.contracts` into the matching keys below.
#
# POOL_FACTORY_CONTRACT_ID or POOL_CONTRACT_ID is required for the Horizon
# event indexer. When both are left empty the indexer starts in a
# disabled/warn-only mode (safe for local dev). Prefer POOL_FACTORY_CONTRACT_ID
# in production — the indexer polls the factory for `pool_created` events and
# automatically starts polling every pool it discovers, instead of a single
# hardcoded pool.
POOL_CONTRACT_ID=
POOL_FACTORY_CONTRACT_ID=
CL_POOL_CONTRACT_ID=
ROUTER_CONTRACT_ID=
POSITION_NFT_CONTRACT_ID=
FEE_COLLECTOR_CONTRACT_ID=
ORACLE_ADAPTER_CONTRACT_ID=
MATH_LIB_CONTRACT_ID=

# ── Token List (optional) ─────────────────────────────────────────────────────
# A Uniswap-compatible token list JSON URL. When set, token metadata is
# enriched on startup and weekly.
TOKEN_LIST_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_ISSUER=swyft-api
JWT_AUDIENCE=swyft-client

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
# development | production | test. Controls fail-fast startup checks (see
# stellar.config.ts, cors.ts) — leave as "development" for local work.
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins, e.g.
# "https://app.example.com,https://www.example.com". Required (no localhost
# fallback) when NODE_ENV=production. CORS_ORIGIN is a fallback if
# WEB_APP_ORIGIN is unset.
WEB_APP_ORIGIN=http://localhost:3000
CORS_ORIGIN=

# ── Internal API key ──────────────────────────────────────────────────────────
# Protects /admin/* and /metrics/db. Set via secret in production.
INTERNAL_API_KEY=change-me-in-production

# ── DB query monitoring ───────────────────────────────────────────────────────
DB_SLOW_QUERY_THRESHOLD_MS=100

# ── Sentry (optional) ────────────────────────────────────────────────────────
# Leave blank to disable error reporting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── OpenTelemetry tracing (optional) ─────────────────────────────────────────
# Leave blank to disable distributed tracing. When set, incoming requests are
# joined to the caller's trace (W3C traceparent) and outgoing HTTP calls this
# service makes carry the trace onward. Points at an OTLP/HTTP collector, e.g.
# http://localhost:4318/v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=swyft-api

# ── Compression ───────────────────────────────────────────────────────────────
COMPRESSION_LEVEL=6

# ── Rate limiting ─────────────────────────────────────────────────────────────
# All limits are requests-per-minute sliding windows, enforced via Redis
# (see REDIS_URL above). "Internal" limits apply to requests carrying a valid
# x-internal-key header matching INTERNAL_API_KEY. See
# apps/api/src/rate-limit/rate-limit.middleware.ts and docs/RATE_LIMITING.md.
RATE_LIMIT_PER_MINUTE=300
INTERNAL_RATE_LIMIT_PER_MINUTE=1200
CANDLE_RATE_LIMIT_PER_MINUTE=60
INTERNAL_CANDLE_RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=10
INTERNAL_AUTH_RATE_LIMIT_PER_MINUTE=60
TRANSACTION_RATE_LIMIT_PER_MINUTE=20
INTERNAL_TRANSACTION_RATE_LIMIT_PER_MINUTE=120
TICKS_RATE_LIMIT_PER_MINUTE=30
INTERNAL_TICKS_RATE_LIMIT_PER_MINUTE=120

# ── Indexer (BullMQ workers) ──────────────────────────────────────────────────
# Optional: default per-queue worker concurrency (defaults to 5 if unset).
# Override a single queue with INDEXER_CONCURRENCY_<QUEUE_NAME>.
INDEXER_CONCURRENCY=
# Optional: milliseconds a SIGTERM/SIGINT shutdown waits for in-flight
# indexer jobs before giving up (default: 25000).
INDEXER_SHUTDOWN_TIMEOUT_MS=

# ── USD price feed ────────────────────────────────────────────────────────────
# Powers price:usd:* (pool TVL/volume/fee-APR pricing). JSON object mapping
# token address to CoinGecko coin id, e.g. {"CA...XLM":"stellar","CB...USDC":"usd-coin"}.
# Refreshed every 5 minutes. Leave unset to skip the refresh (tokens keep
# their last-cached price, or the getUsdPrice() default of 1 if never set).
COINGECKO_TOKEN_ID_MAP=
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# ── Webhooks ─────────────────────────────────────────────────────────────────
# USD notional above which a swap triggers a "large swap" webhook event.
LARGE_SWAP_THRESHOLD_USD=10000
# Consecutive delivery failures after which a webhook is auto-disabled.
WEBHOOK_MAX_CONSECUTIVE_FAILS=10
# Delivery retry attempts (via BullMQ) before a webhook job is marked failed.
WEBHOOK_RETRY_ATTEMPTS=3
