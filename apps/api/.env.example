# ── Database (Prisma) ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swyft

# ── Redis (BullMQ + Cache) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Stellar RPC & Horizon ─────────────────────────────────────────────────────
# Both URLs are validated at startup and, if malformed, the app refuses to
# start regardless of environment. In production (NODE_ENV=production) they
# are also REQUIRED — the app refuses to start if either is missing, with no
# silent fallback to testnet. Outside production, an unset value defaults to
# the public testnet endpoint shown below, for local-dev convenience.
#
# For production deployments, supply these via CI/CD secrets (e.g. GitHub
# Actions secrets: STELLAR_RPC_URL, HORIZON_URL) — never commit real values.
#
# STELLAR_NETWORK must be one of: testnet | mainnet
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# ── Contract Addresses ────────────────────────────────────────────────────────
# POOL_CONTRACT_ID is required for the Horizon event indexer. When left empty
# the indexer starts in a disabled/warn-only mode (safe for local dev).
POOL_CONTRACT_ID=

# ── Token List (optional) ─────────────────────────────────────────────────────
# A Uniswap-compatible token list JSON URL. When set, token metadata is
# enriched on startup and weekly.
TOKEN_LIST_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_ISSUER=swyft-api
JWT_AUDIENCE=swyft-client

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001

# ── Internal API key ──────────────────────────────────────────────────────────
# Protects /admin/* and /metrics/db. Set via secret in production.
INTERNAL_API_KEY=change-me-in-production

# ── DB query monitoring ───────────────────────────────────────────────────────
DB_SLOW_QUERY_THRESHOLD_MS=100

# ── Sentry (optional) ────────────────────────────────────────────────────────
# Leave blank to disable error reporting.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── OpenTelemetry tracing (optional) ─────────────────────────────────────────
# Leave blank to disable distributed tracing. When set, incoming requests are
# joined to the caller's trace (W3C traceparent) and outgoing HTTP calls this
# service makes carry the trace onward. Points at an OTLP/HTTP collector, e.g.
# http://localhost:4318/v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=swyft-api

# ── Compression ───────────────────────────────────────────────────────────────
COMPRESSION_LEVEL=6

# ── Rate limiting ─────────────────────────────────────────────────────────────
# All limits are requests-per-minute sliding windows, enforced via Redis
# (see REDIS_URL above). "Internal" limits apply to requests carrying a valid
# x-internal-key header matching INTERNAL_API_KEY. See
# apps/api/src/rate-limit/rate-limit.middleware.ts and docs/RATE_LIMITING.md.
RATE_LIMIT_PER_MINUTE=300
INTERNAL_RATE_LIMIT_PER_MINUTE=1200
CANDLE_RATE_LIMIT_PER_MINUTE=60
INTERNAL_CANDLE_RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=10
INTERNAL_AUTH_RATE_LIMIT_PER_MINUTE=60
TRANSACTION_RATE_LIMIT_PER_MINUTE=20
INTERNAL_TRANSACTION_RATE_LIMIT_PER_MINUTE=120

# ── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_LARGE_SWAP_USD=10000
