{
  "extends": "@swyft/config/tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@swyft/sdk/position-math": ["../../packages/sdk/src/position-math.ts"]
    },
    "strictPropertyInitialization": false
  }
}
