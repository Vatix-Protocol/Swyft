{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@swyft/config$": "<rootDir>/../../../packages/config/src/index.ts",
    "^@swyft/config/(.*)$": "<rootDir>/../../../packages/config/src/$1"
  }
}
